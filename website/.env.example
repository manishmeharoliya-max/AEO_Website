# Deployed backend origin, without /api. Empty locally uses Vite's /api proxy.
VITE_API_URL=
# Local proxy defaults to http://127.0.0.1:5000 (the full backend server).
API_PROXY=http://127.0.0.1:5000
# Business WhatsApp number with country code, digits only (example: 919876543210).
VITE_WHATSAPP_NUMBER=
